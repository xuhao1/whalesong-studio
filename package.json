{
  "name": "dsh-novel-writer",
  "version": "0.1.0",
  "description": "Long-form fiction studio for DeepSeek Harness: an orchestrator agent, a dedicated prose model, a story bible, ensemble cast tracking, illustrations, audio drama, motion comics and playable interludes",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "novel",
    "fiction",
    "writing",
    "audiobook",
    "visual-novel"
  ],
  "license": "LGPL-3.0-or-later",
  "author": "Dr. Xu",
  "type": "module",
  "icon": "./icon.png",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./agent": "./lib/agent.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "icon.png",
    "native/novel-auth.swift",
    "locale/*.json",
    "skills",
    "docs",
    "LICENSE",
    "COPYING",
    "README.md",
    "README.zh.md",
    "CHANGELOG.md"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepare": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "typecheck": "tsc -p tsconfig.host.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "test": "vitest run",
    "dev": "node scripts/dev.mjs",
    "check": "npm run typecheck && npm run test && npm run build"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.4"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh": ">=0.2.0-rc.2 <0.3.0",
    "@deepseek-ai/dsh-tools": ">=0.2.0-rc.2 <0.3.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh": "0.2.0-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2",
    "@types/node": "^22.10.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "@types/ws": "^8.5.13",
    "esbuild": "^0.25.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0",
    "ws": "^8.18.0",
    "yaml": "^2.6.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xuhao1/dsh-novel-writer.git"
  },
  "homepage": "https://dsh-novel-studio.xuhao1.me",
  "bugs": {
    "url": "https://github.com/xuhao1/dsh-novel-writer/issues"
  }
}
